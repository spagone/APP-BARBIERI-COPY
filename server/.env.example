DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mybarber?schema=public
# Cloud example (Neon/Supabase):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=15
PORT=5000
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
# Optional rate limit tuning (use stricter values in production)
# AUTH_RATE_LIMIT_WINDOW_MS=900000
# AUTH_RATE_LIMIT_MAX=20
# PASSWORD_RESET_RATE_LIMIT_WINDOW_MS=3600000
# PASSWORD_RESET_RATE_LIMIT_MAX=5
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,https://admin.barberapp.com
TRUST_PROXY=false
ADMIN_API_KEY=change-me-for-admin-users-endpoint
ADMIN_BOOTSTRAP_NAME=MyBarber Super Admin
ADMIN_BOOTSTRAP_EMAIL=admin@barberapp.com
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe_1234
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=MyBarber <noreply@barberapp.com>
SMTP_REPLY_TO=support@barberapp.com
GOOGLE_OAUTH_CLIENT_IDS=google-client-id.apps.googleusercontent.com
APPLE_CLIENT_IDS=com.barberapp.mobile,com.barberapp.service
FACEBOOK_APP_ID=123456789012345
FACEBOOK_APP_SECRET=facebook-app-secret
